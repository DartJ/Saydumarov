# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional public Supabase credentials for real-time online multiplayer rooms.
# Never place a service_role key here — only the public anon/publishable key.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
